{
  "name": "muze-bot",
  "version": "1.0.0",
  "private": true,
  "description": "A bilingual Telegram social bot for profiles, AI taste lists, and live discussions.",
  "main": "src/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --no-deprecation ./src/index.js",
    "dashboard": "node --no-deprecation ./scripts/analytics-dashboard.js",
    "load:test": "node --no-deprecation ./scripts/load-test.js",
    "benchmark:people": "node --no-deprecation ./scripts/benchmark-people-discovery.js",
    "benchmark:dashboard": "node --no-deprecation ./scripts/benchmark-analytics-dashboard.js",
    "taste-index:health": "node --no-deprecation ./scripts/repair-taste-index.js",
    "taste-index:repair": "node --no-deprecation ./scripts/repair-taste-index.js --apply",
    "test": "node --test test/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "lint": "eslint .",
    "architecture": "node ./scripts/validate-architecture.js",
    "dev": "nodemon --no-deprecation ./src/index.js",
    "check": "npm run lint && npm run architecture && npm run validate:translations && npm test && npm run test:integration && npm run audit:production",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "validate:translations": "node ./scripts/validate-translations.js",
    "validate:production-config": "node ./scripts/validate-production-config.js",
    "validate:production-dashboard": "node ./scripts/validate-production-config.js --dashboard",
    "create:indexes": "node ./scripts/create-indexes.js",
    "clear:user-data:dry": "node ./scripts/clear-user-data.js --dry-run",
    "clear:user-data": "node ./scripts/clear-user-data.js",
    "seed:people": "node ./scripts/seed-people-test-data.js",
    "seed:discussions": "node ./scripts/seed-discussions-test-data.js"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "axios": "1.18.1",
    "dotenv": "^17.4.2",
    "fuse.js": "^7.3.0",
    "https-proxy-agent": "^5.0.1",
    "mongoose": "^9.7.2",
    "openai": "^6.37.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "eslint": "^10.4.1",
    "nodemon": "^3.1.14"
  }
}
