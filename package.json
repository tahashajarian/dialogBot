{
  "name": "dialogBot",
  "version": "0.0.1",
  "description": "A bilingual Bale social bot for profiles, AI taste lists, and live discussions.",
  "main": "src/index.js",
  "scripts": {
    "start": "node --no-deprecation ./src/index.js",
    "dashboard": "node --no-deprecation ./scripts/analytics-dashboard.js",
    "test": "node --test test/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "lint": "eslint .",
    "dev": "nodemon --no-deprecation ./src/index.js",
    "check": "npm run lint && npm run validate:translations && npm test && npm run test:integration",
    "validate:translations": "node ./scripts/validate-translations.js",
    "clear:data:dry": "node ./scripts/clear-data.js --dry-run",
    "clear:data": "node ./scripts/clear-data.js",
    "migrate:ai-lists:dry": "node ./scripts/migrate-ai-lists.js",
    "migrate:ai-lists": "node ./scripts/migrate-ai-lists.js --apply",
    "migrate:ai-lists:clear-legacy": "node ./scripts/migrate-ai-lists.js --apply --clear-legacy",
    "migrate:public-code-indexes": "node ./scripts/migrate-public-code-indexes.js",
    "rollback:ai-lists:dry": "node ./scripts/rollback-ai-lists.js",
    "rollback:ai-lists": "node ./scripts/rollback-ai-lists.js --apply"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.16.1",
    "dotenv": "^17.4.2",
    "fuse.js": "^7.3.0",
    "mongoose": "^9.6.2",
    "openai": "^6.37.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "eslint": "^10.4.1",
    "nodemon": "^3.1.14"
  }
}
